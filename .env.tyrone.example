# Non-secret Tyrone runtime profile for later server validation.
# Do not copy real credentials into this file.

HIRING_ENVIRONMENT=tyrone
HIRING_DATABASE_URL=postgresql+psycopg://hiring:hiring@127.0.0.1:5433/hiring_platform
HIRING_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

HIRING_ACTOR_PROVIDER=development
HIRING_ALLOW_DEVELOPMENT_ACTOR_PROVIDER=true

HIRING_DOCUMENT_STORAGE_ROOT=/home/danish/projects/Hiring/hiring-platform/.hiring-documents
HIRING_SCREENING_OUTPUT_ROOT=/home/danish/projects/Hiring/hiring-platform/screening-output
HIRING_MAX_UPLOAD_BYTES=10485760

HIRING_SCREENING_PROVIDER=engine
HIRING_SCREENING_ENGINE_ROOT=/home/danish/projects/Hiring/hiring-screening-engine
HIRING_SCREENING_ENGINE_PYTHON="uv run python"
HIRING_SCREENING_ENGINE_TIMEOUT_SECONDS=900
HIRING_SCREENING_WORKER_MAX_ATTEMPTS=1

HIRING_SCREENING_CHANDRA_BASE_URL=http://127.0.0.1:18083
HIRING_SCREENING_CHANDRA_MODEL=chandra-ocr-2-q8
# Stable screening-v1 does not consume CHANDRA_API_KEY. Keep this unset unless the engine adds support later.
# HIRING_SCREENING_CHANDRA_API_KEY=no-key

HIRING_SCREENING_GEMMA_BASE_URL=http://127.0.0.1:24181/v1
HIRING_SCREENING_GEMMA_FALLBACK_BASE_URL=http://127.0.0.1:24182/v1
HIRING_SCREENING_GEMMA_API_KEY=no-key
HIRING_SCREENING_GEMMA_MODEL=/home/danish/models/gemma4-12B/gemma-4-12B-it-qat-UD-Q4_K_XL.gguf
HIRING_SCREENING_GEMMA_RESUME_MAX_TOKENS=16384

HIRING_SCREENING_CHANDRA_OCR_RETRY_MAX_TOKENS=8192
HIRING_SCREENING_PIPELINE_DEBUG_RAW_RESPONSES=false

# Frontend environment:
VITE_API_BASE_URL=http://localhost:8010
VITE_API_PROXY_TARGET=http://localhost:8010
